#include <WiFi.h>
#include <esp_now.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_W 128
#define SCREEN_H 64
#define VIRTUAL_W 256

Adafruit_SSD1306 display(SCREEN_W, SCREEN_H, &Wire, -1);

uint8_t broadcastMAC[] = {0xFF,0xFF,0xFF,0xFF,0xFF,0xFF};

typedef struct {
  char text[48];
  int  scrollX;
  uint8_t magic;
} ScrollPacket;

ScrollPacket pkt;

const char* MESSAGE = "  HELLO FROM TWIN OLED  ***  TWO SCREENS ONE CANVAS  ***  ";

void onSent(const wifi_tx_info_t *info, esp_now_send_status_t status) {}

void setup() {
  Serial.begin(115200);
  Wire.begin(7, 6);
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();
  display.display();

  WiFi.mode(WIFI_STA);
  esp_now_init();
  esp_now_register_send_cb(onSent);

  esp_now_peer_info_t peer = {};
  memcpy(peer.peer_addr, broadcastMAC, 6);
  peer.channel = 0;
  peer.encrypt = false;
  esp_now_add_peer(&peer);

  strncpy(pkt.text, MESSAGE, sizeof(pkt.text) - 1);
  pkt.magic = 0x42;

  // Start off-screen right
  pkt.scrollX = VIRTUAL_W;
}

void loop() {
  // Scroll left by 2 pixels per frame
  pkt.scrollX -= 2;

  // Text is roughly 6 pixels per char wide
  int textWidth = strlen(pkt.text) * 6;
  if (pkt.scrollX < -textWidth) {
    pkt.scrollX = VIRTUAL_W;   // wrap around
  }

  // Broadcast
  esp_now_send(broadcastMAC, (uint8_t*)&pkt, sizeof(pkt));

  // Draw our half: x 0..127
  display.clearDisplay();
  display.setTextSize(2);
  display.setTextColor(SSD1306_WHITE);
  display.setTextWrap(false);
  // shift into local coords: text starts at pkt.scrollX in virtual space
  display.setCursor(pkt.scrollX, 16);
  display.print(pkt.text);
  display.display();

  delay(40);   // ~25 fps — smooth enough for text
}
